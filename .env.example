# Copiar a .env.local o usar .env.development / .env.productive según el entorno.
# No subir archivos con secretos reales al repositorio.

# Entorno lógico: development | qa | production
APP_ENV=development

# --- Clerk (requerido para producción). Si está vacío, la app usa modo demostración.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Local / QA: Turso (libSQL)
DATABASE_URL_TURSO=
DATABASE_TOKEN_TURSO=

# --- Productivo: Supabase (Postgres + Realtime)
DATABASE_URL_SUPABASE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_PWD_SUPABASE=
DATABASE_SERVICES_SUPABASE=

# --- Bold Payments (para procesar pagos en Colombia)
# Obtener claves en: https://plataforma.bold.co/
BOLD_API_KEY_TEST=
BOLD_SECRET_KEY_TEST=
NEXT_PUBLIC_BOLD_PUBLIC_KEY_TEST=
BOLD_API_KEY=
BOLD_SECRET_KEY=
NEXT_PUBLIC_BOLD_PUBLIC_KEY=

# --- Firebase Cloud Messaging (opcional - para notificaciones push a app móvil)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Residente App URL (para notificaciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Log level: debug | info | warn | error
LOG_LEVEL=info

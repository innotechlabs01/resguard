# Copiar a .env.local o usar .env.development / .env.productive según el entorno.
# No subir archivos con secretos reales al repositorio.

# Entorno lógico: development | qa | production
APP_ENV=development

# --- Clerk (opcional). Si está vacío, la app usa el modo demostración con selector de rol.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Local / QA: Turso (libSQL)
DATABASE_URL_TURSO=
DATABASE_TOKEN_TURSO=

# --- Productivo: Supabase (Postgres)
DATABASE_URL_SUPABASE=
# Anon o service role según política (RLS); nombres alineados al proyecto
DATABASE_PWD_SUPABASE=
DATABASE_SERVICES_SUPABASE=

# Clerk Auth (optional - if using Clerk)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=